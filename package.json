    "pitchy": "^4.1.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.1",
    "tailwind-merge": "^3.5.0",
    "tonal": "^6.4.3",
    "tone": "^15.1.22",
